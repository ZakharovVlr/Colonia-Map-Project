{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler", /* Идеально для связки Vite + Tailwind */
    "paths": {
      "@model/*": [
        "./src/model/*"
      ],
      "@view/*": [
        "./src/view/*"
      ],
      "@presenter/*": [
        "./src/presenter/*"
      ]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true, /* Чтобы TS не ругался на внутренние типы библиотек */
    "incremental": true, /* Ускорение сборки (Инкрементальная компиляция) */
    /* Разделение потоков по Практикуму */
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/**/*" /* Следим только за исходниками */
  ],
  "exclude": [
    "node_modules",
    "dist" /* Исключаем собранные "вареники" из проверки */
  ]
}